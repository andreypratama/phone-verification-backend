# Nomor SIM pada Android SMS Forwarder yang ditampilkan kepada pengguna.
GATEWAY_PHONE_NUMBER=081100009999

# Secret berbeda direkomendasikan untuk API aplikasi dan Android Forwarder.
# Minimal 32 karakter. Jangan commit nilai production.
API_HMAC_SECRET=change-this-api-secret-at-least-32-characters
SMS_FORWARDER_HMAC_SECRET=change-this-sms-secret-at-least-32-characters

# Konfigurasi opsional.
DEFAULT_COUNTRY_CODE=62
VERIFICATION_PREFIX=VERIF
VERIFICATION_CODE_LENGTH=8
VERIFICATION_TTL=PT10M
HMAC_ALLOWED_CLOCK_SKEW=PT5M
HMAC_NONCE_CLEANUP_MILLIS=600000
